#!/usr/bin/env python3
"""Portable development CLI. No runtime network or field-accuracy claims."""
import argparse,json,subprocess,sys,tempfile,random,math,statistics,hashlib
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
def build():
 out=ROOT/'build'/'hx-reconstruct';out.parent.mkdir(exist_ok=True)
 subprocess.run(['c++','-std=c++17','-O2',str(ROOT/'packages/spatial-core/hx_core.cpp'),str(ROOT/'packages/spatial-core/cli.cpp'),'-o',str(out)],check=True)
 return out
def simulate(seed,path):
 # Three visible planes, deliberately unobserved rear region. Independent noise
 # per camera; correlated bias is a separately labelled adversarial scenario.
 rng=random.Random(seed);points=[(x*.06+.01,y*.06+.01,1.01) for x in range(20) for y in range(20)]
 observations=[]
 for frame in range(8):
  for p in points:
   if rng.random()<.06:continue
   q=[v+rng.gauss(0,.001) for v in p]
   observations.append(' '.join(map(str,q+[1,frame])))
 path.mkdir(parents=True,exist_ok=True)
 (path/'observations.xyz').write_text('\n'.join(observations)+'\n')
 # Evaluator-only truth is never provided to the executable.
 (path/'truth.json').write_text(json.dumps({'points':points,'seed':seed,'scope':'analytic depth fusion, known noisy pose priors; not localization or sensor simulation'}))
def evaluate(candidate,truth):
 pts=[list(map(float,l.split())) for l in candidate.read_text().splitlines()]
 gt=json.loads(truth.read_text())['points']
 errors=[min(math.dist(p[:3],g) for g in gt) for p in pts]
 completeness=sum(any(math.dist(p[:3],g)<.01 for p in pts) for g in gt)/len(gt)
 return {'count':len(pts),'completeness':completeness,'p95_m':sorted(errors)[int(.95*(len(errors)-1))] if errors else None,'max_m':max(errors) if errors else None}
def test(output=None):
 exe=build();subprocess.run(['c++','-std=c++17','-O2',str(ROOT/'packages/spatial-core/hx_core.cpp'),str(ROOT/'packages/spatial-core/test.cpp'),'-o',str(exe)+'-test'],check=True);subprocess.run([str(exe)+'-test'],check=True)
 surface=ROOT/'build/hx-surface-test'
 subprocess.run(['c++','-std=c++17','-O2',str(ROOT/'packages/spatial-core/hx_surface.cpp'),str(ROOT/'packages/spatial-core/surface_test.cpp'),'-o',str(surface)],check=True)
 surface_report=subprocess.check_output([str(surface)]).decode();(ROOT/'build/evidence').mkdir(parents=True,exist_ok=True);(ROOT/'build/evidence/surface-tests.json').write_text(surface_report)
 results=[]
 with tempfile.TemporaryDirectory() as tmp:
  for seed in range(50):
   p=Path(tmp)/str(seed);simulate(seed,p)
   with (p/'observations.xyz').open('rb') as src,(p/'candidate.xyz').open('wb') as out:subprocess.run([str(exe)],stdin=src,stdout=out,check=True)
   result=evaluate(p/'candidate.xyz',p/'truth.json');result['seed']=seed;results.append(result)
 report={'suite':'portable C++ analytic fusion','not_tested':['ARKit','image matching','pose optimization','localization','field precision','Blender sensor simulation'],'cases':results,'passed':all(r['p95_m']<.003 and r['completeness']>.98 for r in results)}
 target=output or ROOT/'build/evidence/portable-tests.json';target.parent.mkdir(parents=True,exist_ok=True);target.write_text(json.dumps(report,indent=2));print(json.dumps({'passed':report['passed'],'cases':len(results),'max_p95_m':max(r['p95_m'] for r in results),'report':str(target)}));return 0 if report['passed'] else 1
def main():
 import hm_commands
 from package_check import check_package
 p=argparse.ArgumentParser(description=__doc__);sub=p.add_subparsers(dest='cmd',required=True)
 doctor=sub.add_parser('doctor',help='Inspect available capabilities without provisioning');doctor.add_argument('--live',action='store_true');doctor.add_argument('--output',type=Path)
 t=sub.add_parser('test');t.add_argument('--suite',choices=['portable','simulation','release','commands'],default='portable');t.add_argument('--output',type=Path)
 s=sub.add_parser('simulate');s.add_argument('--seed',type=int,default=42);s.add_argument('--output',type=Path,required=True)
 s.add_argument('--scenario',choices=['analytic-depth','connected-house'],default='analytic-depth');s.add_argument('--stage',choices=['rough','finished'],default='rough');s.add_argument('--profile',default='nominal');s.add_argument('--width',type=int,default=384)
 s.add_argument('--scene-variant',choices=['baseline','windows-clutter'],default='baseline')
 r=sub.add_parser('reconstruct',help='Production native image/depth processing or portable XYZ fusion');r.add_argument('--bundle',type=Path,required=True);r.add_argument('--output',type=Path,required=True)
 r.add_argument('--simulator');r.add_argument('--bundle-id',default='com.example.HouseMemoryProof');r.add_argument('--kind',choices=['points','surface','complete']);r.add_argument('--segment');r.add_argument('--timeout',type=int,default=900)
 e=sub.add_parser('evaluate');e.add_argument('--candidate',type=Path,required=True);e.add_argument('--truth',type=Path);e.add_argument('--fixture',type=Path);e.add_argument('--output',type=Path)
 tour=sub.add_parser('tour',help='Run production TourDirector in an explicitly selected installed Debug simulator app')
 tour.add_argument('--scene',type=Path,required=True);tour.add_argument('--preset',choices=['overview','before-after','services'],default='overview');tour.add_argument('--duration',type=float,default=20)
 tour.add_argument('--simulator',required=True);tour.add_argument('--bundle-id',default='com.example.HouseMemoryProof');tour.add_argument('--output',type=Path,required=True)
 c=sub.add_parser('export-check');c.add_argument('--package',type=Path,required=True);c.add_argument('--output',type=Path)
 health=sub.add_parser('release-health');health.add_argument('--live',action='store_true');health.add_argument('--input',type=Path);health.add_argument('--output',type=Path)
 release=sub.add_parser('release');release.add_argument('--commit',required=True);release.add_argument('--ref',default='main');release.add_argument('--ship',action='store_true');release.add_argument('--dispatch',action='store_true');release.add_argument('--output',type=Path)
 a=p.parse_args()
 try:
  if a.cmd=='doctor':return hm_commands.write_report(hm_commands.doctor(a.live),a.output)
  if a.cmd=='test':return test(a.output) if a.suite=='portable' else hm_commands.run_suite(a.suite,a.output)
  if a.cmd=='simulate':
   if a.output.exists():raise ValueError('Choose a new simulation directory; previous evidence is preserved')
   if a.scenario=='analytic-depth':
    if a.scene_variant!='baseline':raise ValueError('Scene variants require --scenario connected-house')
    simulate(a.seed,a.output);return 0
   return subprocess.run([sys.executable,str(ROOT/'tooling/simulation/whole_house_fixture.py'),str(a.output),'--seed',str(a.seed),'--stage',a.stage,'--profile',a.profile,'--width',str(a.width),'--scene-variant',a.scene_variant],cwd=ROOT).returncode
  if a.cmd=='reconstruct':
   if a.output.exists():raise ValueError('Choose a new reconstruction path; existing output is preserved')
   if a.simulator:
    if not 1<=a.timeout<=3600:raise ValueError('Native command timeout must be between 1 and 3600 seconds')
    return hm_commands.write_report(hm_commands.reconstruct(a.bundle,a.kind or 'complete',a.segment,a.simulator,a.bundle_id,a.output,a.timeout))
   if a.bundle.is_dir() or a.bundle.suffix.lower() not in ['.xyz','.txt'] or a.kind or a.segment:raise ValueError('Image/depth reconstruction requires --simulator. The portable legacy input is an XYZ text file.')
   exe=build()
   with a.bundle.open('rb') as src,a.output.open('xb') as out:subprocess.run([str(exe)],stdin=src,stdout=out,check=True)
   return 0
  if a.cmd=='evaluate':
   if a.fixture:
    if a.truth or not a.output:raise ValueError('Localization evaluation requires --fixture and --output, without --truth')
    return subprocess.run([sys.executable,str(ROOT/'tooling/simulation/replay_fixture.py'),'--executable',str(a.candidate),'--fixture',str(a.fixture),'--output',str(a.output),'--house','--refine','--bundle'],cwd=ROOT).returncode
   if not a.truth:raise ValueError('Analytic depth evaluation requires --truth; localization requires --fixture')
   return hm_commands.write_report(evaluate(a.candidate,a.truth),a.output)
  if a.cmd=='tour':return hm_commands.write_report(hm_commands.tour(a.scene,a.preset,a.duration,a.simulator,a.bundle_id,a.output))
  if a.cmd=='export-check':
   if a.output and a.output.resolve()==a.package.resolve():
    a.output=None
    raise ValueError('The validation report must not replace its source package')
   return hm_commands.write_report(hm_commands.check_export(a.package),a.output)
  if a.cmd in ['release-health','release']:
   sys.path.insert(0,str(ROOT/'ci'))
   import release_health
   if a.cmd=='release':return hm_commands.write_report(release_health.release(a.commit,a.ref,a.ship,a.dispatch),a.output)
   if a.input and a.live:raise ValueError('Choose either a saved snapshot or live read-only checks')
   snapshot=json.loads(a.input.read_text()) if a.input else release_health.collect_live()
   policy=json.loads((ROOT/'ci/release-policy.json').read_text())
   return hm_commands.write_report(release_health.summarize(snapshot,policy),a.output)
 except Exception as error:
  target=getattr(a,'output',None) if a.cmd in ['release-health','release','test','evaluate','export-check','doctor'] else None
  return hm_commands.write_report(dict(passed=False,command=a.cmd,error=str(error)[:2000]),target)

if __name__=='__main__':sys.exit(main())
